# Optional LLM configuration (not used by Phase 1)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

# Literature providers
# OpenAlex currently requires an API key for the Works API.
OPENALEX_API_KEY=
# Semantic Scholar API key is optional but recommended for higher/individual limits.
SEMANTIC_SCHOLAR_API_KEY=

# Conservative provider client settings
AGENTIC_RESEARCH_USER_AGENT=Agentic-Research/0.2 (+https://github.com/ZHX4/Agentic-Research)
REQUEST_TIMEOUT_SECONDS=30
OPENALEX_MIN_INTERVAL_SECONDS=0.1
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.0
ARXIV_MIN_INTERVAL_SECONDS=3.0
